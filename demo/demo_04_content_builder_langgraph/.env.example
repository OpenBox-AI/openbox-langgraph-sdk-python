# OpenBox Core - required
OPENBOX_URL=https://your-openbox-core.example.com
OPENBOX_API_KEY=obx_live_xxx
OPENBOX_AGENT_NAME=ContentBuilderAgent

# IAM v3: set the PKCS8 PEM RSA key for the agent's active workload identity.
# Supply the PEM contents through OPENBOX_WORKLOAD_PRIVATE_KEY (not a file path).
# Leave this variable unset when using API-key-only or legacy DID authentication.
# OPENBOX_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# OpenAI - required
OPENAI_API_KEY=sk-xxx

# Optional. If a key is absent the matching tool degrades gracefully (skipped).
TAVILY_API_KEY=tvly-xxx
GOOGLE_API_KEY=xxx
